# Supabase
DATABASE_URL=postgresql://...
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 수집
CONTACT_EMAIL=            # User-Agent에 붙일 연락처
YOUTUBE_API_KEY=
ASSEMBLY_API_KEY=         # 열린국회정보 OpenAPI

# LLM (무료 등급)
GEMINI_API_KEY=           # Google AI Studio
GROQ_API_KEY=             # GroqCloud (Gemini 한도 초과 시 예비)

# 전달
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=         # 받는 사람 chat id, 쉼표로 여러 명
TELEGRAM_ADMIN_CHAT_ID=   # (선택) 운영 경고만 받을 사람. 비우면 위 모두에게
GMAIL_USER=               # 보내는 Gmail 주소
GMAIL_APP_PASSWORD=       # Google 계정 > 보안 > 앱 비밀번호 (16자리)
BRIEFING_EMAIL_TO=        # 받는 사람, 쉼표로 여러 명
DASHBOARD_URL=
